<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="16dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:paddingRight="16dp">

    <TextView
        android:id="@+id/ap_pat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        android:text="Apellido"
        android:layout_marginLeft="10dp"
        android:layout_alignParentTop="true"
        android:layout_toEndOf="@+id/nombre" />

    <TextView
        android:id="@+id/run"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16dp"
        android:text="run"
        android:layout_below="@+id/nombre"
        android:layout_marginLeft="10dp"
        android:layout_toEndOf="@+id/icon_user" />

    <TextView
        android:id="@+id/nombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        android:text="Nombre"
        android:layout_marginLeft="10dp"
        android:layout_alignParentTop="true"
        android:layout_toEndOf="@+id/icon_user" />

    <TextView
        android:id="@+id/icon_user"
        android:text="@string/icon_user"
        android:textSize="26dp"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:layout_alignParentTop="true"
        android:textColor="#2b4c70"
        android:padding="5dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/round_icon_user"
        android:layout_alignParentStart="true" />

    <TextView
        android:id="@+id/dv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16dp"
        android:text="dv"
        android:layout_below="@+id/nombre"
        android:layout_toEndOf="@+id/run"
        android:layout_marginStart="10dp" />
</RelativeLayout >